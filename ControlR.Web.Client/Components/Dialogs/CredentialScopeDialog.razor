@using ControlR.Libraries.Api.Contracts.Enums
@using ControlR.Web.Client.Components.Shared

<MudDialog>
  <DialogContent>
    <MudText Typo="Typo.h6" Class="mb-2">@CredentialName</MudText>
    <MudGrid Spacing="2">
      @foreach (var row in _rows)
      {
        <MudItem xs="12">
          <MudPaper Elevation="1" Class="pa-2">
            <MudGrid Spacing="2">
              <MudItem xs="12" md="5">
                <MudSelect T="string" @bind-Value="row.PermissionName" Label="Permission" Required="true"
                           Dense="true" MaxHeight="400">
                  @foreach (var entry in _catalog)
                  {
                    <MudSelectItem T="string" Value="@entry.Name">@entry.DisplayName (@entry.Name)</MudSelectItem>
                  }
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="2">
                <MudSelect T="PermissionEffect" @bind-Value="row.Effect" Label="Effect" Dense="true">
                  <MudSelectItem Value="PermissionEffect.Allow">Allow</MudSelectItem>
                  <MudSelectItem Value="PermissionEffect.Deny">Deny</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="2">
                <MudSelect T="PermissionScopeKind" @bind-Value="row.ScopeKind" Label="Scope Kind" Dense="true">
                  <MudSelectItem Value="PermissionScopeKind.Server">Server</MudSelectItem>
                  <MudSelectItem Value="PermissionScopeKind.Tenant">Tenant</MudSelectItem>
                  <MudSelectItem Value="PermissionScopeKind.Device">Device</MudSelectItem>
                  <MudSelectItem Value="PermissionScopeKind.DeviceGroup">Device Group</MudSelectItem>
                  <MudSelectItem Value="PermissionScopeKind.CustomerTenant">Customer</MudSelectItem>
                </MudSelect>
              </MudItem>
              <MudItem xs="12" md="2">
                <ScopeAutocomplete @bind-SelectedId="row.ScopeId"
                                   ScopeKind="@row.ScopeKind"
                                   Label="Scope"
                                   Class="mb-0" />
              </MudItem>
              <MudItem xs="12" md="1" Class="d-flex align-end justify-end">
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="() => RemoveRow(row)" />
              </MudItem>
            </MudGrid>
          </MudPaper>
        </MudItem>
      }
    </MudGrid>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="AddRow">Add scope</MudButton>
    <MudButton OnClick="Cancel">Cancel</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Save">Save</MudButton>
  </DialogActions>
</MudDialog>
