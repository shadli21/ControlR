<MudDialog>
  <DialogContent>
    <MudStack Spacing="3">
      <MudTextField T="string" @bind-Value="_name" Label="Name" Required="true" />
      <MudSelect T="int" @bind-Value="_expirationDays" Label="Expires">
        <MudSelectItem Value="NeverValue">Never</MudSelectItem>
        <MudSelectItem Value="30">In 30 days</MudSelectItem>
        <MudSelectItem Value="90">In 90 days</MudSelectItem>
        <MudSelectItem Value="365">In 1 year</MudSelectItem>
        <MudSelectItem Value="CustomValue">Custom</MudSelectItem>
      </MudSelect>
      @if (_expirationDays == CustomValue)
      {
        <MudDatePicker @bind-Date="_customDate" Label="Expiration Date" MinDate="MinDate" Required="true" />
        <MudTimePicker @bind-Time="_customTime" Label="Expiration Time" AmPm="true" Required="true" />
      }
    </MudStack>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancel</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="Save" Disabled="!CanSave">Create</MudButton>
  </DialogActions>
</MudDialog>
