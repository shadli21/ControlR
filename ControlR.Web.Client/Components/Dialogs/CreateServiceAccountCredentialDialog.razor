<MudDialog>
  <DialogContent>
    <MudStack Spacing="3">
      <MudTextField T="string" @bind-Value="_name" Label="Name" Required="true" />
      <ExpirationPicker @bind-Value="_expiresAt" />
    </MudStack>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancel</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="Save" Disabled="@string.IsNullOrWhiteSpace(_name)">Create</MudButton>
  </DialogActions>
</MudDialog>
