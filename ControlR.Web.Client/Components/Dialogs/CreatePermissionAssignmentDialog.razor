@using ControlR.Libraries.Api.Contracts.Enums
@using ControlR.Libraries.Api.Contracts.Dtos.ServerApi.Internal

<MudDialog>
  <DialogContent>
    <MudGrid Spacing="2">
      <MudItem xs="12">
        <MudSelect T="string" @bind-Value="_permissionName" Label="Permission" Required="true"
                   Dense="true" MaxHeight="400">
          @foreach (var entry in _catalog)
          {
            <MudSelectItem T="string" Value="@entry.Name">@entry.DisplayName (@entry.Name)</MudSelectItem>
          }
        </MudSelect>
      </MudItem>
      <MudItem xs="6">
        <MudSelect T="PermissionEffect" @bind-Value="_effect" Label="Effect">
          <MudSelectItem Value="PermissionEffect.Allow">Allow</MudSelectItem>
          <MudSelectItem Value="PermissionEffect.Deny">Deny</MudSelectItem>
        </MudSelect>
      </MudItem>
      <MudItem xs="6">
        <MudSelect T="PermissionScopeKind" @bind-Value="_scopeKind" Label="Scope Kind">
          <MudSelectItem Value="PermissionScopeKind.Server">Server</MudSelectItem>
          <MudSelectItem Value="PermissionScopeKind.Tenant">Tenant</MudSelectItem>
          <MudSelectItem Value="PermissionScopeKind.Device">Device</MudSelectItem>
          <MudSelectItem Value="PermissionScopeKind.DeviceGroup">Device Group</MudSelectItem>
        </MudSelect>
      </MudItem>
      <MudItem xs="12">
        <MudTextField T="string" @bind-Value="_scopeId" Label="Scope ID (optional GUID)" />
      </MudItem>
      <MudItem xs="12">
        <MudTextField T="string" @bind-Value="_notes" Label="Notes (optional)" Lines="2" />
      </MudItem>
    </MudGrid>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancel</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Submit">Create</MudButton>
  </DialogActions>
</MudDialog>
