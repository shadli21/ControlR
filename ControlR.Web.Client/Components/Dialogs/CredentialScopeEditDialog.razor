@using ControlR.Libraries.Api.Contracts.Enums
@using ControlR.Web.Client.Components.Shared
@using InternalDtos = ControlR.Libraries.Api.Contracts.Dtos.ServerApi.Internal

<MudDialog>
  <DialogContent>
    <MudGrid Spacing="2">
      <MudItem xs="12">
        <MudAutocomplete T="InternalDtos.PermissionCatalogEntryDto"
                         Value="_selectedPermission"
                         ValueChanged="HandlePermissionChanged"
                         SearchFunc="SearchPermissions"
                         Label="Permission"
                         Clearable="true"
                         MaxItems="null"
                         Required="true"
                         Dense="true"
                         MaxHeight="400"
                         ResetValueOnEmptyText="true"
                         CoerceText="true"
                         CoerceValue="false"
                         ToStringFunc="PermissionLabel" />
      </MudItem>
      <MudItem xs="12">
        <MudSelect T="PermissionScopeKind" @bind-Value="_scopeKind" Label="Scope Kind" Disabled="_selectedPermission is null">
          @foreach (var scopeKind in _selectedPermission?.AllowedScopeKinds ?? [])
          {
            var kind = scopeKind;
            <MudSelectItem Value="kind">@ScopeKindLabel(kind)</MudSelectItem>
          }
        </MudSelect>
      </MudItem>
      <MudItem xs="12">
        <ScopeAutocomplete ScopeKind="_scopeKind"
                           @bind-SelectedId="_scopeId"
                           Label="Scope"
                           Class="mb-2" />
      </MudItem>
    </MudGrid>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancel</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Submit">Add Scope</MudButton>
  </DialogActions>
</MudDialog>
