@using ControlR.Libraries.Api.Contracts.Dtos

<MudDialog>
  <DialogContent>
    <MudStack Spacing="2">
      <MudTextField T="string"
                    @bind-Value="_searchText"
                    Label="Search devices"
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    Immediate="true"
                    DebounceInterval="400"
                    OnDebounceIntervalElapsed="OnSearchChanged"
                    Clearable="true" />

      @if (_loading)
      {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
      }
      else
      {
        <MudPaper MaxHeight="350px" Class="overflow-y-auto pa-2">
          @foreach (var device in _devices)
          {
            <MudCheckBox T="bool"
                         Value="_selectedIds.Contains(device.Id)"
                         ValueChanged="@(v => ToggleSelection(device.Id, v))"
                         Color="Color.Primary"
                         Dense="true">
              @DeviceDisplay.GetDisplayName(device)
            </MudCheckBox>
          }
          @if (_devices.Count == 0)
          {
            <MudText Typo="Typo.body2" Class="pa-4 mud-text-secondary">No devices found.</MudText>
          }
        </MudPaper>

        <MudPagination Selected="_currentPage" Count="_totalPages" BoundaryCount="1" SelectedChanged="OnPageChanged" Size="Size.Small" />
      }
    </MudStack>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancel</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Add" Disabled="@(_selectedIds.Count == 0)">
      Add (@_selectedIds.Count)
    </MudButton>
  </DialogActions>
</MudDialog>
