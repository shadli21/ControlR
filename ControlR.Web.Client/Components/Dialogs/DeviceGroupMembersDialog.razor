@using ControlR.Libraries.Api.Contracts.Dtos.ServerApi.Internal

<MudDialog>
  <DialogContent>
    <MudGrid>
      <MudItem xs="12">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Devices in @_groupName</MudText>
        @if (_loading)
        {
          <MudProgressCircular Indeterminate="true" />
        }
        else
        {
          <MudPaper MaxHeight="400px" Class="overflow-y-auto pa-2">
            @foreach (var device in _devices)
            {
              <MudSwitch T="bool"
                         Value="@_memberIds.Contains(device.Id)"
                         Color="Color.Primary"
                         ValueChanged="@(async isToggled => await ToggleDevice(device.Id, isToggled))">
                @device.Name
              </MudSwitch>
            }
          </MudPaper>
        }
      </MudItem>
    </MudGrid>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Close</MudButton>
  </DialogActions>
</MudDialog>
