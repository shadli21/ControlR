@using ControlR.Web.Client.Components.Dialogs

<MudDialog>
  <DialogContent>
    <MudStack Spacing="3">
      <MudTextField T="string" @bind-Value="_name" Label="Name" Required="true" />
      <MudTextField T="string" @bind-Value="_description" Label="Description" Lines="2" />
      <MudTextField T="string" @bind-Value="_notes" Label="Notes" Lines="2" />
    </MudStack>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancel</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="Save" Disabled="@string.IsNullOrWhiteSpace(_name)">Save</MudButton>
  </DialogActions>
</MudDialog>
