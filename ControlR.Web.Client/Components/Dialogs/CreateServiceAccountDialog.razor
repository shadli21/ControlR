<MudDialog>
  <DialogContent>
    <MudStack Spacing="3">
      <MudTextField T="string" @bind-Value="_name" Label="Name" Required="true" />
      <MudTextField T="string" @bind-Value="_description" Label="Description" Sizing="InputSizing.Auto" MaxLines="4" />

      @if (IsServerAccount)
      {
        <MudSelect T="ServiceAccountAccessMode" @bind-Value="_accessMode" Label="Access Mode">
          <MudSelectItem Value="ServiceAccountAccessMode.Restricted">Restricted (assignment-scoped)</MudSelectItem>
          <MudSelectItem Value="ServiceAccountAccessMode.Unrestricted">Unrestricted (full server access)</MudSelectItem>
        </MudSelect>
        <MudAlert Severity="Severity.Info">
          <strong>Restricted</strong>: the account can only do what its permission assignments allow.
          No assignments means no access.
          <br />
          <strong>Unrestricted</strong>: the account has full server access regardless of assignments.
        </MudAlert>
      }

      @if (CanIssueCredential)
      {
        <MudSwitch T="bool" @bind-Value="_createCredential" Label="Create Initial Credential" Color="Color.Primary" />
        @if (_createCredential)
        {
          <MudTextField T="string" @bind-Value="_credentialName" Label="Credential Name" Required="true" />
          <ExpirationPicker @bind-Value="_credentialExpiresAt" />
        }
      }
      else
      {
        <MudAlert Severity="Severity.Warning">
          You don't have permission to issue credentials for service accounts. The account will be
          created without a credential. Ask an administrator to grant you the
          <strong>@RotatePermissionLabel</strong> permission, then add a credential to the account.
        </MudAlert>
      }
    </MudStack>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancel</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="Save" Disabled="!CanSave">Create</MudButton>
  </DialogActions>
</MudDialog>
