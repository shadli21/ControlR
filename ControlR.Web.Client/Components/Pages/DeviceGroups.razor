@attribute [Route(ClientRoutes.DeviceGroups)]
@attribute [Authorize(Policy = PolicyNames.RequireDeviceGroupsRead)]

<PageTitle>Device Groups</PageTitle>

<PrimaryTitle>
  Device Groups
</PrimaryTitle>

<MudDataGrid T="DeviceGroupDto"
             Items="_groups"
             Hover="true"
             Loading="_loading"
             QuickFilter="_quickFilter"
             Breakpoint="Breakpoint.Sm">
  <ToolBarContent>
    <MudTextField T="string"
                  @bind-Value="_searchString"
                  Placeholder="Search"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true"
                  Class="mr-4" />
    <MudSpacer />
    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="CreateGroup">
      New Group
    </MudButton>
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Refresh" />
  </ToolBarContent>
  <Columns>
    <PropertyColumn Property="x => x.Name" Title="Name" />
    <PropertyColumn Property="x => x.Description" Title="Description" />
    <PropertyColumn Property="x => x.MemberCount" Title="Devices" />
    <TemplateColumn Title="ID" Sortable="false" Filterable="false">
      <CellTemplate>
        <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
          <MudText Typo="Typo.body2">@(TruncateId(context.Item.Id))</MudText>
          <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                         Size="Size.Small"
                         OnClick="@(() => CopyId(context.Item.Id))" />
        </MudStack>
      </CellTemplate>
    </TemplateColumn>
    <PropertyColumn Property="x => x.CreatedAt" Title="Created" />
    <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
      <CellTemplate>
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Info" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopRight">
          <MudMenuItem Icon="@Icons.Material.Filled.Group" IconColor="Color.Info" OnClick="@(() => ViewGroup(context.Item))">View Members</MudMenuItem>
          <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(() => DeleteGroup(context.Item))">Delete</MudMenuItem>
        </MudMenu>
      </CellTemplate>
    </TemplateColumn>
  </Columns>
  <PagerContent>
    <MudDataGridPager T="DeviceGroupDto" />
  </PagerContent>
</MudDataGrid>
