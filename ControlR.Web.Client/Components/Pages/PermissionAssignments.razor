@attribute [Route(ClientRoutes.Permissions)]
@attribute [Authorize(Roles = RoleNames.TenantAdministrator)]

<PageTitle>Permission Assignments</PageTitle>

<PrimaryTitle>
  Permission Assignments
</PrimaryTitle>

<MudGrid>
  <MudItem xs="12" md="4">
    <MudPaper Class="pa-4">
      <MudText Typo="Typo.h6" Class="mb-3">Query Principal</MudText>
      <MudSelect T="string" @bind-Value="_principalKind" Label="Principal Kind" Class="mb-2">
        <MudSelectItem Value="@("User")">User</MudSelectItem>
        <MudSelectItem Value="@("UserGroup")">User Group</MudSelectItem>
        <MudSelectItem Value="@("ServiceAccount")">Service Account</MudSelectItem>
      </MudSelect>
      <MudTextField T="string" @bind-Value="_principalId" Label="Principal ID (GUID)" Class="mb-2" />
      <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAssignments" FullWidth="true">
        Load Assignments
      </MudButton>
    </MudPaper>
  </MudItem>
  <MudItem xs="12" md="8">
    @if (_loading)
    {
      <MudProgressCircular Indeterminate="true" />
    }
    else if (_assignments is not null)
    {
      <MudDataGrid T="PermissionAssignmentDto"
                   Items="_assignments"
                   Hover="true"
                   Dense="true">
        <ToolBarContent>
          <MudSpacer />
          <MudButton Variant="Variant.Outlined"
                     Color="Color.Primary"
                     StartIcon="@Icons.Material.Filled.Add"
                     OnClick="CreateAssignment"
                     Size="Size.Small">
            New Assignment
          </MudButton>
        </ToolBarContent>
        <Columns>
          <PropertyColumn Property="x => x.PermissionName" Title="Permission" />
          <PropertyColumn Property="x => x.Effect" Title="Effect" />
          <PropertyColumn Property="x => x.ScopeKind" Title="Scope" />
          <PropertyColumn Property="x => x.ScopeId" Title="Scope ID" />
          <PropertyColumn Property="x => x.IsEnabled" Title="Enabled" />
          <TemplateColumn Title="" Sortable="false" Filterable="false">
            <CellTemplate>
              <MudIconButton Icon="@Icons.Material.Filled.Delete"
                             Color="Color.Error"
                             Size="Size.Small"
                             OnClick="@(() => DeleteAssignment(context.Item))" />
            </CellTemplate>
          </TemplateColumn>
        </Columns>
      </MudDataGrid>
    }
    else
    {
      <MudText Typo="Typo.body1" Color="Color.Default">
        Select a principal and load assignments to view permission rules.
      </MudText>
    }
  </MudItem>
</MudGrid>
